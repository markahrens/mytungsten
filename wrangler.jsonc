{
	"compatibility_date": "2026-05-27",
	"compatibility_flags": ["nodejs_compat", "no_handle_cross_request_promise_resolution"],
	"name": "mytungsten",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adsb_v2",
      "database_id": "929c96be-db2f-49be-b008-275727019350"
    }
  ]
}