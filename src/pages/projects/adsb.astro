---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import { getLiveCollection } from "astro:content";
import AdsbFlightRow from "../../components/AdsbFlightRow.astro";
import { DateTime } from "luxon";

const url = new URL(Astro.request.url);
const dateParam = url.searchParams.get("date");

const tz = "America/Chicago";
let selectedDate = DateTime.now().setZone(tz);

if (dateParam) {
  const parsed = DateTime.fromISO(dateParam, { zone: tz });
  if (parsed.isValid) {
    selectedDate = parsed;
  }
}

const dateStr = selectedDate.toFormat("yyyy-MM-dd");
const adsbResult = await getLiveCollection("adsb", { date: dateStr });

if (adsbResult.error) {
  console.error("ADSB Live Collection error:", adsbResult.error);
}

const flights = adsbResult.entries ?? [];

const prevDateStr = selectedDate.minus({ days: 1 }).toFormat("yyyy-MM-dd");
const nextDateStr = selectedDate.plus({ days: 1 }).toFormat("yyyy-MM-dd");
const todayZone = DateTime.now().setZone(tz);
const isToday = selectedDate.hasSame(todayZone, "day");
const isTodayOrFuture = selectedDate.startOf("day") >= todayZone.startOf("day");

const minDate = DateTime.fromISO("2026-07-28", { zone: tz });
const isAtMinDateOrBefore = selectedDate.startOf("day") <= minDate.startOf("day");
const isBeforeMinDate = selectedDate.startOf("day") < minDate.startOf("day");

const badgeDate = selectedDate.toLocaleString(DateTime.DATE_HUGE);

// --- Daily Summary Computation ---

// Top 5 airports by combined appearances (origin + destination)
const airportCounts: Record<string, { iata: string; name: string; city: string; count: number }> = {};
for (const f of flights) {
  const d = f.data;
  if (d.origin && d.origin_code_iata) {
    const key = d.origin_code_iata;
    if (!airportCounts[key]) airportCounts[key] = { iata: key, name: d.origin_name || key, city: d.origin_city || '', count: 0 };
    airportCounts[key].count++;
  }
  if (d.destination && d.destination_code_iata) {
    const key = d.destination_code_iata;
    if (!airportCounts[key]) airportCounts[key] = { iata: key, name: d.destination_name || key, city: d.destination_city || '', count: 0 };
    airportCounts[key].count++;
  }
}
const topAirports = Object.values(airportCounts)
  .sort((a, b) => b.count - a.count)
  .slice(0, 15);

// Flights by airline (operated_by label, fallback to airline code)
const airlineCounts: Record<string, number> = {};
for (const f of flights) {
  const label = f.data.operated_by || f.data.airline || 'Unknown';
  airlineCounts[label] = (airlineCounts[label] ?? 0) + 1;
}
const airlineBreakdown = Object.entries(airlineCounts)
  .sort(([, a], [, b]) => b - a);
const maxAirlineCount = airlineBreakdown[0]?.[1] ?? 1;

// Top 5 aircraft models
const modelCounts: Record<string, number> = {};
for (const f of flights) {
  const m = f.data.model || f.data.type || 'Unknown';
  modelCounts[m] = (modelCounts[m] ?? 0) + 1;
}
const topModels = Object.entries(modelCounts)
  .sort(([, a], [, b]) => b - a)
  .slice(0, 5);
const maxModelCount = topModels[0]?.[1] ?? 1;

// Headline stats
const busiestAirline = airlineBreakdown[0]?.[0] ?? null;
---

<Layout title="ADSB Flight Tracker">
  <main>
    <div class="content-container masthead">
      <h1>ADSB Flight Tracker</h1>
      <p class="subtitle">Flights tracked by my local ADSB receiver.</p>
    </div>

    {flights.length > 0 && !isBeforeMinDate && (
      <div class="summary-panel-outer">
        <div class="content-container">
          <div class="summary-panel">

            <!-- Headline stats row -->
            <div class="summary-headline">
              <div class="headline-stat">
                <span class="headline-label">Flights Tracked</span>
                <span class="headline-num">{flights.length}</span>
              </div>
              {busiestAirline && (
                <div class="headline-stat busiest">
                  <span class="headline-label">Busiest Airline</span>
                  <span class="headline-num">{busiestAirline}</span>
                </div>
              )}
            </div>

            <!-- Three-column breakdown -->
            <div class="summary-cols">

              <!-- Top Airports -->
              <div class="summary-col">
                <h3 class="col-title">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                  Top Airports
                </h3>
                <ol class="ranked-list">
                  {topAirports.map((ap, i) => (
                    <li class="ranked-item">
                      <span class="rank-num">{i + 1}</span>
                      <div class="rank-info">
                        <span class="rank-code">{ap.iata}</span>
                        <span class="rank-dash">–</span>
                        <span class="rank-name">{ap.name}</span>
                      </div>
                      <span class="rank-count">{ap.count}</span>
                    </li>
                  ))}
                </ol>
              </div>

              <!-- Airlines -->
              <div class="summary-col">
                <h3 class="col-title">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21 4 19 2c-2-2-4-2-5.5-.5L10 5 1.8 6.2c-.5.1-.9.5-.8 1.1l.2.8c.1.5.5.9 1 1l2.7.3 3.5 6.1c.2.3.6.5 1 .4l.9-.2c.5-.1.9-.5.8-1l-.4-2.7L14 9l1.2 7.8c.1.5.5.9 1 .8l.9-.2c.4-.1.7-.4.7-.8z"/></svg>
                  Airlines
                </h3>
                <div class="airline-bars">
                  {airlineBreakdown.map(([name, count]) => (
                    <div class="airline-bar-row">
                      <span class="airline-name">{name}</span>
                      <div class="bar-track">
                        <div class="bar-fill" style={`width: ${Math.round((count / maxAirlineCount) * 100)}%`}></div>
                      </div>
                      <span class="airline-count">{count}</span>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Top Models -->
              <div class="summary-col">
                <h3 class="col-title">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                  Top Aircraft Models
                </h3>
                <ol class="model-list">
                  {topModels.map(([model, count], i) => (
                    <li class="model-item">
                      <div class="model-header">
                        <span class="model-rank">{i + 1}</span>
                        <span class="model-name">{model}</span>
                        <span class="model-count">{count}</span>
                      </div>
                      <div class="model-bar-track">
                        <div class="model-bar-fill" style={`width: ${Math.round((count / maxModelCount) * 100)}%`}></div>
                      </div>
                    </li>
                  ))}
                </ol>
              </div>

            </div>
          </div>
        </div>
      </div>
    )}

    <div class="bg-container">
      <div class="content-container">
        <div class="section-header">
          <h2>Flights Seen {isToday ? "Today" : "on " + selectedDate.toLocaleString(DateTime.DATE_MED)}</h2>
          
          <div class="archive-nav">
            {!isAtMinDateOrBefore && (
              <a href={`?date=${prevDateStr}`} class="nav-link prev" title="Previous Day">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width.5="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                <span>Prev</span>
              </a>
            )}
            
            <span class="date-badge">{badgeDate}</span>
            
            {!isTodayOrFuture && !isBeforeMinDate && (
              <a href={`?date=${nextDateStr}`} class="nav-link next" title="Next Day">
                <span>Next</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width.5="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </a>
            )}
          </div>
        </div>

        {!isToday && (
          <div class="jump-today-wrapper">
            <a href="?" class="jump-today-link">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><polyline points="16 3 21 8 16 13"></polyline><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><polyline points="8 21 3 16 8 11"></polyline></svg>
              Return to Today
            </a>
          </div>
        )}

        <div class="flights-list">
          {
            flights.length > 0 ? (
              flights.map((flight) => (
                <AdsbFlightRow
                  hex={flight.data.hex}
                  registration={flight.data.registration}
                  model={flight.data.model}
                  flight={flight.data.flight}
                  seen_date={flight.data.seen_date}
                  operator={flight.data.operator}
                  origin={flight.data.origin}
                  destination={flight.data.destination}
                  owner={flight.data.owner}
                  airline={flight.data.airline}
                  airline_code_iata={flight.data.airline_code_iata}
                  operated_by={flight.data.operated_by}
                  origin_code_iata={flight.data.origin_code_iata}
                  origin_name={flight.data.origin_name}
                  origin_city={flight.data.origin_city}
                  destination_code_iata={flight.data.destination_code_iata}
                  destination_name={flight.data.destination_name}
                  destination_city={flight.data.destination_city}
                />
              ))
            ) : (
              <div class="empty-state">
                <span class="icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="none"/><path d="M88,224l24-24V176l24-24,48,72,24-24-32-88,33-31A24,24,0,0,0,175,47L144,80,56,48,32,72l72,48L80,144H56L32,168l40,16Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/></svg></span>
                {isBeforeMinDate ? (
                  <p>Data does not exist before July 28, 2026.</p>
                ) : (
                  <p>No flights detected by the receiver {isToday ? "yet today" : "on this date"}.</p>
                )}
              </div>
            )
          }
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  /* ── Daily Summary Panel ── */
  .summary-panel-outer {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-muted);
    padding: var(--space-10) 0;
    margin-bottom: 0;

    @media (max-width: 600px) {
      padding: var(--space-6) 0;
    }
  }

  .summary-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    min-width: 0;

    @media (max-width: 600px) {
      gap: var(--space-6);
    }
  }

  /* Headline row */
  .summary-headline {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);

    @media (width < 480px) {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }
  }

  .headline-stat {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    padding: var(--space-4) var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
    min-width: 0;

    @media (max-width: 600px) {
      padding: var(--space-4);
    }

    @media (width > 480px) {
      flex-direction: row;
      align-items: center;
    }

    .headline-label {
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--color-metallic);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .headline-num {
      font-family: var(--font-hanken-grotesk);
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--color-text);
      line-height: 1;
      word-break: break-word;
    }
  }

  /* Three column breakdown */
  .summary-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);

    @media (max-width: 900px) {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }
  }

  .summary-col {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    padding: var(--space-5) var(--space-6);
    min-width: 0;

    @media (max-width: 600px) {
      padding: var(--space-4);
    }
  }

  .col-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-metallic);
    margin: 0 0 var(--space-4);

    svg {
      flex-shrink: 0;
      opacity: 0.7;
    }
  }

  /* Top Airports */
  .ranked-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ranked-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    min-width: 0;

    .rank-num {
      font-family: var(--font-hanken-grotesk);
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--color-metallic);
      width: 16px;
      flex-shrink: 0;
      text-align: center;
    }

    .rank-info {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 4px 6px;

      .rank-code {
        font-family: var(--font-hanken-grotesk);
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--color-text);
        flex-shrink: 0;
      }

      .rank-dash {
        font-size: 0.82rem;
        color: var(--color-metallic);
        flex-shrink: 0;
      }

      .rank-name {
        font-size: 0.82rem;
        color: var(--color-metallic);
        word-break: break-word;
      }
    }

    .rank-count {
      font-family: var(--font-hanken-grotesk);
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--color-text);
      background: var(--color-bg-muted);
      padding: 2px 8px;
      border-radius: var(--radius-pill);
      border: 1px solid var(--color-border);
      flex-shrink: 0;
      align-self: flex-start;
    }
  }

  /* Airlines bar chart */
  .airline-bars {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .airline-bar-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 10px;

    .airline-name {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--color-text);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      min-width: 0;
    }

    .bar-track {
      width: 80px;
      height: 6px;
      background: var(--color-border);
      border-radius: var(--radius-pill);
      overflow: hidden;
      flex-shrink: 0;

      .bar-fill {
        height: 100%;
        background: var(--color-text);
        border-radius: var(--radius-pill);
        transition: width 0.4s ease;
      }
    }

    .airline-count {
      font-family: var(--font-hanken-grotesk);
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--color-text);
      min-width: 20px;
      text-align: right;
    }
  }

  /* Top Models */
  .model-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .model-item {
    min-width: 0;

    .model-header {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      margin-bottom: 5px;
      min-width: 0;

      .model-rank {
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--color-metallic);
        width: 14px;
        flex-shrink: 0;
      }

      .model-name {
        flex: 1;
        font-family: var(--font-hanken-grotesk);
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--color-text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        min-width: 0;
      }

      .model-count {
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--color-metallic);
        flex-shrink: 0;
      }
    }

    .model-bar-track {
      height: 4px;
      background: var(--color-border);
      border-radius: var(--radius-pill);
      overflow: hidden;
      margin-left: 22px;

      .model-bar-fill {
        height: 100%;
        background: var(--color-text);
        border-radius: var(--radius-pill);
        opacity: 0.35;
        transition: width 0.4s ease;
      }
    }
  }

  /* ── rest of original styles ── */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-4);
    gap: var(--space-4);
    flex-wrap: wrap;

    h2 {
      margin: 0;
      font-size: 1.5rem;
      font-weight: 700;
    }
  }

  .archive-nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-bg-offset, #f4f4f5);
    padding: var(--space-1);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);

    .date-badge {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--color-text, #18181b);
      padding: 6px 12px;
      background: var(--color-white, #ffffff);
      border-radius: var(--radius-xs);
      box-shadow: 0 1px 2px rgba(0,0,0,0.05);
      white-space: nowrap;
    }

    .nav-link {
      display: flex;
      align-items: center;
      gap: 4px;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--color-text-offset, #71717a);
      text-decoration: none;
      padding: 6px 12px;
      border-radius: var(--radius-xs);
      transition: all 0.2s ease;

      &:hover:not(.disabled) {
        color: var(--color-text, #18181b);
        background: rgba(0, 0, 0, 0.05);
      }

      &.disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }
    }
  }

  .jump-today-wrapper {
    display: flex;
    justify-content: flex-end;
    margin-top: calc(-1 * var(--space-4));
    margin-bottom: var(--space-6);

    .jump-today-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--color-primary, #2563eb);
      text-decoration: none;
      padding: 6px 12px;
      background: rgba(37, 99, 235, 0.08);
      border-radius: var(--radius-xs);
      transition: all 0.2s ease;

      &:hover {
        background: rgba(37, 99, 235, 0.15);
        transform: translateY(-1px);
      }
    }
  }

  .flights-list {
    display: flex;
    flex-direction: column;
  }

  .empty-state {
    text-align: center;
    padding: var(--space-12) var(--space-6);
    border: 1px dashed var(--color-border);
    background: var(--color-white);
    
    .icon {
      display: block;
      width: 32px;
      height: 32px;
      margin: var(--space-4) auto;
    }

    p {
      color: var(--color-metallic);
      font-weight: 500;
      margin: 0;
    }
  }
</style>
