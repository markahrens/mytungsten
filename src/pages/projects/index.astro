---
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Projects">
  <main class="projects-page">
    <div class="content-container masthead">
      <h1>Projects</h1>
      <p class="subtitle">Things I've built, collect, and experiment with.</p>
    </div>

    <div class="content-container">
      <div class="projects-list card">
        <a href="/projects/puzzmo" class="project-row">
          <div class="icon-col"><Icon name="lucide:layout-grid" size={20} /></div>
          <div class="title-col">Puzzmo Games</div>
          <div class="desc-col">Current status of Puzzmo games played.</div>
          <div class="arrow-col"><Icon name="lucide:arrow-right" size={16} /></div>
        </a>

        <a href="/projects/adsb" class="project-row">
          <div class="icon-col"><Icon name="lucide:plane" size={20} /></div>
          <div class="title-col">ADSB Flight Tracker</div>
          <div class="desc-col">Flights tracked by my local ADSB receiver</div>
          <div class="arrow-col"><Icon name="lucide:arrow-right" size={16} /></div>
        </a>

        <a href="https://bowls.mytungsten.net" class="project-row">
          <div class="icon-col"><Icon name="lucide:pie-chart" size={20} /></div>
          <div class="title-col">Bowl Report</div>
          <div class="desc-col">College football bowl game results, since 2000.</div>
          <div class="arrow-col"><Icon name="lucide:arrow-right" size={16} /></div>
        </a>

        <a href="/projects/eulers" class="project-row">
          <div class="icon-col"><Icon name="lucide:pi" size={20} /></div>
          <div class="title-col">Euler's Identity</div>
          <div class="desc-col">A tribute to one of mathematics' most beautiful equations.</div>
          <div class="arrow-col"><Icon name="lucide:arrow-right" size={16} /></div>
        </a>

        <a href="/projects/ipod-for-windows" class="project-row">
          <div class="icon-col"><Icon name="lucide:smartphone" size={20} /></div>
          <div class="title-col">iPod for Windows</div>
          <div class="desc-col">A review of the Windows port of iTunes for the iPod.</div>
          <div class="arrow-col"><Icon name="lucide:arrow-right" size={16} /></div>
        </a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .projects-page {
    padding-bottom: var(--space-12);
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .project-row {
    display: grid;
    grid-template-columns: 48px 220px 1fr 40px;
    align-items: center;
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    transition: background-color var(--transition-standard);

    &:last-child {
      border-bottom: none;
    }

    &:hover {
      background-color: var(--color-surface-alt);

      .title-col {
        color: var(--color-primary);
      }

      .arrow-col {
        transform: translateX(3px);
      }
    }

    @media (max-width: 850px) {
      grid-template-columns: 40px 1fr 30px;
      gap: var(--space-3);
      padding: var(--space-4);
    }
  }

  .category-col {
    font-size: 0.75rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    letter-spacing: 0.05em;

    @media (max-width: 850px) {
      display: none;
    }
  }

  .icon-col {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary-dark);
  }

  .title-col {
    font-size: 1.125rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-primary-dark);
    transition: color var(--transition-standard);
  }

  .desc-col {
    font-size: 0.9375rem;
    color: var(--color-text-muted);

    @media (max-width: 850px) {
      display: none;
    }
  }

  .arrow-col {
    display: flex;
    justify-content: flex-end;
    color: var(--color-primary-dark);
    transition: transform var(--transition-standard);
  }
</style>


