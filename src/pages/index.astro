---
import Layout from '../layouts/Layout.astro';
import { Icon } from "astro-icon/components";
import BlogPost from '../components/PostRow.astro';
import TungstenCard from '../components/TungstenCard.astro';
import { getCollection } from 'astro:content';


const latestPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const latestPost = latestPosts[0];
const recentPosts = latestPosts.slice(1, 5);

const siteUpdates = [
  { date: 'May 30, 2026', title: 'Puzzmo page added' },
  { date: 'Dec 17, 2025', title: 'Flight Log launched' },
  { date: 'Dec 31, 2023', title: 'Website platform updated' }
];

const dateOptions: object = {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
};
---

<Layout title="Home">
  <main class="home-page">
    <div class="content-container hero-section">
      <div class="hero-text">
        <h1 class="hero-title">MyTungsten</h1>
        <p class="subtitle">
          The personal website of Mark Ahrens—web technology expert, Drupal specialist, farmer, and soccer fan.
        </p>
        <a href="/about" class="more-link">
          More about Mark <Icon name="ph:arrow-right" size={16} />
        </a>
      </div>

      <div class="hero-card">
        <TungstenCard />
      </div>
    </div>

    <div class="content-container home-grid">
      <!-- Latest Post Column -->
      <div class="grid-col latest-col">
        <span class="eyebrow">LATEST POST</span>
        {latestPost && (
          <div class="latest-card card">
            <span class="post-date">
              {latestPost.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </span>
            <h2 class="post-title">
              <a href={`/blog/${latestPost.id}`}>{latestPost.data.title}</a>
            </h2>
            <p class="post-desc">{latestPost.data.description}</p>
            <a href={`/blog/${latestPost.id}`} class="read-link">
              Read post 
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        )}
      </div>

      <!-- Recent Posts Column -->
      <div class="grid-col recent-col">
        <span class="eyebrow">RECENT POSTS</span>
        <div class="posts-list">
          {recentPosts.map(post => (
            <div class="post-row-item">
              <a href={`/blog/${post.id}`} class="post-row-title">{post.data.title}</a>
              <span class="post-row-date">{post.data.date.toLocaleDateString('en-US', dateOptions)}</span>
            </div>
          ))}
        </div>
        <a href="/blog" class="view-all-link">
          View all posts 
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <!-- Site Updates Column -->
      <div class="grid-col updates-col">
        <span class="eyebrow">SITE UPDATES</span>
        <div class="updates-list">
          {siteUpdates.map(update => (
            <div class="update-row-item">
              <span class="update-title">{update.title}</span>
              <span class="update-date">{update.date}</span>
            </div>
          ))}
        </div>
        
      </div>
    </div>

    <footer class="content-container footer-bar">
      <span>© 2001–2026 Mark Ahrens</span>
      <span class="footer-meta">Built with Astro • Hosted on Cloudflare</span>
    </footer>
  </main>
</Layout>

<style>
  .home-page {
    padding-top: var(--space-8);
  }

  .hero-section {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-8);
    align-items: center;
    padding-bottom: var(--space-10);

    @media (max-width: 850px) {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  .hero-title {
    font-size: clamp(3rem, 5vw, 4.25rem);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary-dark);
    margin: 0 0 var(--space-3) 0;
    letter-spacing: -0.03em;
  }

  .subtitle {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
    max-width: 540px;
  }

  .more-link, .read-link, .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-primary-dark);
    font-weight: var(--font-weight-medium);
    font-size: 0.9375rem;
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }

  .home-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: var(--space-8);
    padding-top: var(--space-8);
    padding-bottom: var(--space-12);
    border-top: 1px solid var(--color-border);

    @media (max-width: 900px) {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  .grid-col {
    display: flex;
    flex-direction: column;
  }

  .latest-card {
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    height: 100%;

    .post-date {
      font-size: 0.75rem;
      font-weight: var(--font-weight-bold);
      color: var(--color-accent);
      margin-bottom: var(--space-2);
    }

    .post-title {
      font-size: 1.5rem;
      font-weight: var(--font-weight-bold);
      margin: 0 0 var(--space-3) 0;

      a {
        color: var(--color-primary-dark);
        text-decoration: none;

        &:hover {
          text-decoration: underline;
        }
      }
    }

    .post-desc {
      font-size: 0.9375rem;
      color: var(--color-text-muted);
      line-height: 1.5;
      margin-bottom: var(--space-5);
    }

    .read-link {
      margin-top: auto;
    }
  }

  .posts-list, .updates-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .post-row-item, .update-row-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px dashed var(--color-border);
  }

  .post-row-title, .update-title {
    font-size: 0.9375rem;
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
    text-decoration: none;

    &:hover {
      color: var(--color-primary);
    }
  }

  .post-row-date, .update-date {
    font-size: 0.75rem;
    color: var(--color-accent);
    white-space: nowrap;
  }

  .footer-bar {
    display: flex;
    justify-content: space-between;
    padding-top: var(--space-6);
    padding-bottom: var(--space-8);
    border-top: 1px solid var(--color-border);
    font-size: 0.8125rem;
    color: var(--color-text-muted);

    @media (max-width: 600px) {
      flex-direction: column;
      gap: var(--space-2);
    }
  }
</style>

