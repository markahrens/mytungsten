---
import Layout from '../../layouts/Layout.astro';
import { Icon } from "astro-icon/components";
import FlightRow from '../../components/FlightRow.astro';
import { getAllFlights, getAirportInfo } from '../../lib/db';

const flights = getAllFlights();
let flightDistances = 0;
let airports = [];

function haversineDistance(lat1: number, lon1: number, lat2:number, lon2: number) {
    const R = 3959; // Earth's radius in miles
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lon2 - lon1) * Math.PI / 180;
    const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
              Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
              Math.sin(dLon/2) * Math.sin(dLon/2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    return R * c;
}

flights.forEach(flight => {
  if (!airports.includes(flight.dept_airport)) {
    airports.push(flight.dept_airport);
  }
  if (!airports.includes(flight.arrival_airport)) {
    airports.push(flight.arrival_airport);
  }
  const deptAirport = getAirportInfo(flight.dept_airport);
  const arrivalAirport = getAirportInfo(flight.arrival_airport);
  if (deptAirport && arrivalAirport) {
    flight.distance = haversineDistance(
      deptAirport.lat,
      deptAirport.long,
      arrivalAirport.lat,
      arrivalAirport.long
    );
  } else {
    flight.distance = null;
  }
  flightDistances += flight.distance || 0;
});

// Group flights by year
const flightsByYear = flights.reduce((acc, flight) => {
  const year = new Date(flight.date).getFullYear();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(flight);
  return acc;
}, {} as Record<number, typeof flights>);

// Sort years in descending order
const sortedYears = Object.keys(flightsByYear).sort((a, b) => Number(b) - Number(a));
---

<Layout title="Flights">
  <main class="flights-page">
    <div class="content-container masthead">
      <h1>Flight Log</h1>
      <p class="subtitle">A record of every flight I've taken since 2013.</p>
    </div>
    <div class="bg-container">
    <div class="content-container summary-container">
      <div class="stat-card card">
        <div class="stat-icon"><Icon name="ph:airplane-tilt" size={40} /></div>
        <div class="stat-content">
          <span class="stat-value">{flights.length}</span>
          <span class="stat-label">FLIGHTS</span>
        </div>
      </div>

      <div class="stat-card card">
        <div class="stat-icon"><Icon name="ph:map-pin" size={40} /></div>
        <div class="stat-content">
          <span class="stat-value">{Math.round(flightDistances).toLocaleString()}</span>
          <span class="stat-label">MILES</span>
        </div>
      </div>

      <div class="stat-card card">
        <div class="stat-icon"><Icon name="ph:air-traffic-control" size={40} /></div>
        <div class="stat-content">
          <span class="stat-value">{airports.length}</span>
          <span class="stat-label">AIRPORTS</span>
        </div>
      </div>
    </div>

    <div class="content-container">
      {sortedYears.map(year => (
        <section class="year-section">
          <h2 class="year-heading">{year}</h2>
          <div class="flights-list">
            {flightsByYear[year as unknown as number].map(flight => (
              <FlightRow
                href={`/flights/${flight.number}-${flight.date}`}
                number={flight.number}
                airline={flight.airline_code}
                dept_airport={flight.dept_airport}
                arrival_airport={flight.arrival_airport}
                date={flight.date}
                distance={flight.distance}
              />
            ))}
          </div>
        </section>
      ))}

      <div class="archive-link-container">
        <a href="/flights" class="archive-link">
          View all flights (2013–2025) 
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
    </div>
  </main>
</Layout>

<style>
  .flights-page {
    padding-bottom: var(--space-12);
  }

  .summary-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin-bottom: var(--space-10);

    @media (max-width: 750px) {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }

  .stat-card {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .stat-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary-dark);
  }

  .stat-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .stat-value {
    font-size: 2.25rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-primary-dark);
    line-height: 1;
    margin-bottom: 4px;
  }

  .stat-label {
    font-size: 0.75rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    letter-spacing: 0.08em;
  }

  .flights-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .archive-link-container {
    margin-top: var(--space-6);
  }

  .archive-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9375rem;
    font-weight: var(--font-weight-medium);
    color: var(--color-primary-dark);
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }
</style>

