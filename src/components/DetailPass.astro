---
interface Props {
  /** A page-specific hook, such as "boarding-pass" or "ticket-pass". */
  class?: string;
  brandColor: string;
  stripe: string;
  stubWidth?: number;
  collapseAt?: 900 | 1000;
}

const {
  class: className,
  brandColor,
  stripe,
  stubWidth = 280,
  collapseAt = 900,
} = Astro.props;
---

<section
  class:list={['detail-pass', 'card', `detail-pass--collapse-${collapseAt}`, className]}
  style={`--detail-pass-brand: ${brandColor}; --detail-pass-stripe: ${stripe}; --detail-pass-stub-width: ${stubWidth}px;`}
>
  <header class="detail-pass__header"><slot name="header" /></header>
  <div class="detail-pass__body">
    <div class="detail-pass__main"><slot name="main" /></div>
    <div class="detail-pass__perforation" aria-hidden="true"></div>
    <aside class="detail-pass__stub"><slot name="stub" /></aside>
  </div>
  <footer class="detail-pass__footer" aria-hidden="true"></footer>
</section>

<style>
  .detail-pass {
    box-shadow: var(--shadow-card);
    margin-bottom: var(--space-15);
    overflow: hidden;
  }

  .detail-pass__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-6) var(--space-8);
    color: var(--color-white);
    background: var(--detail-pass-brand);
  }

  .detail-pass__body {
    display: grid;
    grid-template-columns: 1fr auto var(--detail-pass-stub-width);
    gap: var(--space-8);
    padding: var(--space-10) var(--space-8);
  }

  .detail-pass__perforation {
    width: 1px;
    margin: calc(-1 * var(--space-10)) 0;
    border-left: 2px dashed var(--color-border);
  }

  .detail-pass__footer {
    height: var(--space-2);
    opacity: 0.8;
    background-image: var(--detail-pass-stripe);
  }

  @media (max-width: 900px) {
    .detail-pass--collapse-900 .detail-pass__body {
      grid-template-columns: 1fr;
    }

    .detail-pass--collapse-900 .detail-pass__perforation,
    .detail-pass--collapse-900 .detail-pass__stub {
      display: none;
    }
  }

  @media (max-width: 1000px) {
    .detail-pass--collapse-1000 .detail-pass__body {
      grid-template-columns: 1fr;
    }

    .detail-pass--collapse-1000 .detail-pass__perforation,
    .detail-pass--collapse-1000 .detail-pass__stub {
      display: none;
    }
  }
</style>
