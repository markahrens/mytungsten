---
---

<div class="tungsten-card card">
  <div class="element-tile">
    <div class="tile-top">
      <span class="atomic-number">74</span>
    </div>
    <span class="symbol">W</span>
    <span class="atomic-mass">183.84</span>
  </div>

  <div class="details-pane">
    <div class="element-title">TUNGSTEN</div>
    <ul class="props-list">
      <li>
        <span class="icon">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
        </span>
        <span class="prop-label">Atomic Weight</span>
        <span class="prop-value">183.84</span>
      </li>
      <li>
        <span class="icon">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"></path>
          </svg>
        </span>
        <span class="prop-label">Melting Point</span>
        <span class="prop-value">3,422°C</span>
      </li>
      <li>
        <span class="icon">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 9a4 4 0 0 0-4 4c0 2.21 1.79 4 4 4s4-1.79 4-4a4 4 0 0 0-4-4z"></path>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
          </svg>
        </span>
        <span class="prop-label">Boiling Point</span>
        <span class="prop-value">5,930°C</span>
      </li>
      <li>
        <span class="icon">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
          </svg>
        </span>
        <span class="prop-label">Transition Metal</span>
      </li>
    </ul>
  </div>
</div>

<style>
  .tungsten-card {
    display: flex;
    align-items: stretch;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    margin-bottom: var(--space-6);
  }

  .element-tile {
    width: 140px;
    background: var(--color-surface-alt);
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4) var(--space-3);
    flex-shrink: 0;
  }

  .tile-top {
    width: 100%;
    display: flex;
    justify-content: flex-start;
  }

  .atomic-number {
    font-size: 1.25rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-primary-dark);
    line-height: 1;
  }

  .symbol {
    font-size: 3.5rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    line-height: 1;
    margin: var(--space-2) 0;
  }

  .atomic-mass {
    font-size: 1rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
    line-height: 1;
  }

  .details-pane {
    flex: 1;
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .element-title {
    font-size: 0.85rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-primary-dark);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-3);
  }

  .props-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);

    li {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 0.8125rem;
      color: var(--color-text);
      line-height: 1.3;
      margin-bottom: 0;

      .icon {
        display: flex;
        align-items: center;
        color: var(--color-text-muted);
      }

      .prop-label {
        color: var(--color-text);
      }

      .prop-value {
        margin-left: auto;
        font-weight: var(--font-weight-semibold);
        color: var(--color-text);
      }
    }
  }
</style>



