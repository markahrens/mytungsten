---
const { href, title, category, detail, venue_name, venue_city, date } = Astro.props;
const newDate = new Date(date);
newDate.setUTCHours(12, 0, 0, 0);

const categoryIcons: Record<string, string> = {
  sport: '🏟️',
  concert: '🎸',
  theater: '🎭',
  other: '🎟️'
};

const icon = categoryIcons[category] || '🎟️';
---

<div class="event-row-container">
  <a href={href} class="event-row card card--interactive">
    <div class="date-col">
      <span class="month">{newDate.toLocaleDateString('en-US', { month: 'short' })}</span>
      <span class="day">{newDate.getUTCDate()}</span>
    </div>
    
    <div class="info-col">
      <div class="title-row">
        <span class="icon">{icon}</span>
        <span class="title">{title}</span>
      </div>
      <div class="venue-info">
        {venue_name ? `${venue_name} • ` : ''}{venue_city}
      </div>
    </div>

    <div class="details-col">
      {detail && <span class="subcategory-tag">{detail}</span>}
    </div>
  </a>
</div>

<style>
  .event-row-container {
    margin-bottom: var(--space-3);
  }

  .event-row {
    display: grid;
    grid-template-columns: minmax(90px, auto) 1fr auto;
    align-items: center;
    padding: var(--space-4) var(--space-6);
    gap: var(--space-6);
    text-decoration: none;
    color: inherit;
    &:before {
      display: none;
    }
  }

  .date-col {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
    border-right: 1px solid var(--color-border);
    padding-right: var(--space-6);
    
    .month, .day {
      font-family: var(--font-hanken-grotesk);
      font-size: 1.4rem;
      font-weight: 600;
      color: var(--color-text);
    }
  }

  .info-col {
    .title-row {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      margin-bottom: var(--space-1);
      
      .icon {
        font-size: 1.2rem;
      }

      .title {
        font-family: var(--font-hanken-grotesk);
        font-size: 1.3rem;
        font-weight: 600;
        color: var(--color-text);
      }
    }
    
    .venue-info {
      font-size: 0.9rem;
      color: var(--color-metallic);
      font-weight: 500;
    }
  }

  .details-col {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-2);
    
    .subcategory-tag {
      font-size: 0.75rem;
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: 0.05em;
      padding: 2px var(--space-2);
      background: var(--color-bg-muted);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      color: var(--color-metallic);
    }
  }

  @media (max-width: 600px) {
    .event-row {
      grid-template-columns: minmax(70px, auto) 1fr;
      padding: var(--space-3) var(--space-4);
      gap: var(--space-4);
    }
    .date-col {
      padding-right: var(--space-4);
      .day { font-size: 1.2rem; }
    }
    .details-col {
      display: none;
    }
  }
</style>
