---
import { Icon } from "astro-icon/components";

const {
  registration,
  model,
  flight,
  seen_date,
  owner,
  origin,
  destination,
  airline,
  operator,
  operated_by,
  origin_code_iata,
  origin_name,
  origin_city,
  destination_code_iata,
  destination_name,
  destination_city,
  airline_code_iata,
} = Astro.props;

const iataCode = airline_code_iata || (airline && airline.length === 2 ? airline.toUpperCase() : null);

// Dynamically match local images from src/content/images/airline-logos/{IATA}.png
const logoModules = import.meta.glob<{ default: ImageMetadata }>('../content/images/airline-logos/*.png', { eager: true });
const matchedLogoKey = iataCode ? Object.keys(logoModules).find((path) => path.endsWith(`/${iataCode.toUpperCase()}.png`)) : null;
const logoSrc = matchedLogoKey ? logoModules[matchedLogoKey].default.src : null;

const airlineDisplayName = operated_by || owner || operator;
---

<div class="adsb-row-container">
  <div class="adsb-row card">
    <!-- Route details (Origin -> Destination) -->
    <div class="route-col">
      {origin && destination ? (
        <div class="airport-group origin-group">
          <span class="code">{origin_code_iata || origin}</span>
          <span class="airport-name">{origin_name || origin_city || ""}</span>
        </div>
        <div class="arrow-group">
          <Icon name="ph:arrow-right" size={16} class="arrow" />
        </div>
        <div class="airport-group dest-group">
          <span class="code">{destination_code_iata || destination}</span>
          <span class="airport-name">{destination_name || destination_city || ""}</span>
        </div>
      ) : (
        <div class="no-route-group">
          <span class="no-route">No Known Route</span>
        </div>
      )}
    </div>

    <!-- Right side information: Airline name, Flight / Tail info, and Logo -->
    <div class="right-col">
      <div class="airline-details">
        {airlineDisplayName && <div class="airline-name">{airlineDisplayName}</div>}
        <div class="flight-tail-line">
          {flight && <span class="flight-number">{flight}</span>}
          {flight && registration && <span class="bullet">•</span>}
          {registration && <span class="registration">{registration}</span>}
          {model && (registration || flight) && <span class="bullet model-bullet-mobile">•</span>}
          {model && <span class="model-inline">{model}</span>}
        </div>
        {model && (
          <div class="model-line desktop-only">
            {model}
          </div>
        )}
      </div>

      <!-- Far right logo badge or placeholder badge -->
      <div class="logo-col">
        {logoSrc ? (
          <img
            src={logoSrc}
            alt={iataCode || "Airline"}
            class="airline-logo"
            loading="lazy"
          />
        ) : iataCode ? (
          <div class="airline-code-badge">
            {iataCode}
          </div>
        ) : (
          <div class="airline-code-badge placeholder">
            --
          </div>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  .adsb-row-container {
    margin-bottom: var(--space-3);
  }

  .adsb-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: var(--space-4) var(--space-6);
    gap: var(--space-6);
    transition: transform var(--transition-standard), border-color var(--transition-standard), box-shadow var(--transition-standard), background-color var(--transition-standard);
  }

  /* Left route section with fixed columns so origin/destination line up vertically across rows */
  .route-col {
    display: flex;
    align-items: flex-start;
    flex: 1 1 auto;
  }

  .airport-group {
    display: flex;
    flex-direction: column;
    width: 200px;
    flex-shrink: 0;
  }

  .airport-group .code {
    font-family: var(--font-hanken-grotesk);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.1;
  }

  .airport-group .airport-name {
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--color-metallic);
    line-height: 1.35;
    margin-top: 2px;
  }

  .arrow-group {
    width: 48px;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0 var(--space-2);
    flex-shrink: 0;
    margin-top: 4px;
  }

  .arrow {
    color: var(--color-metallic);
    flex-shrink: 0;
  }

  .no-route-group {
    width: 400px;
  }

  .no-route {
    font-family: var(--font-hanken-grotesk);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-metallic);
  }

  /* Right column section */
  .right-col {
    display: flex;
    align-items: flex-start;
    gap: var(--space-5);
    text-align: right;
    margin-left: auto;
    flex-shrink: 0;
  }

  .airline-details {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }

  .airline-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.1;
  }

  .flight-tail-line {
    font-size: 0.85rem;
    color: var(--color-metallic);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .flight-number {
    font-weight: 600;
    color: var(--color-metallic);
  }

  .registration {
    font-weight: 500;
  }

  .bullet {
    opacity: 0.5;
  }

  .model-line {
    font-size: 0.8rem;
    color: var(--color-metallic);
    font-weight: 400;
    margin-top: 1px;
  }

  .model-bullet-mobile,
  .model-inline {
    display: none;
  }

  /* Logo column on far right */
  .logo-col {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .airline-logo {
    width: 40px;
    height: 40px;
    object-fit: contain;
    border-radius: var(--radius-xs, 4px);
  }

  .airline-code-badge {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-hanken-grotesk);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-text);
    background: var(--color-bg-muted, #f4f4f5);
  }

  .airline-code-badge.placeholder {
    color: var(--color-metallic);
    font-weight: 400;
  }

  @media (max-width: 768px) {
    .adsb-row {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-3);
    }

    .route-col {
      width: 100%;
      justify-content: space-between;
      border-bottom: 1px solid var(--color-border);
      padding-bottom: var(--space-3);
    }

    .airport-group {
      width: 0;
      flex: 1 1 0%;
    }

    .dest-group {
      text-align: right;
      align-items: flex-end;
    }

    .arrow-group {
      width: auto;
      flex-shrink: 0;
      padding: 0 var(--space-2);
      margin-top: 4px;
    }

    .no-route-group {
      width: auto;
    }

    .right-col {
      width: 100%;
      flex-direction: row-reverse;
      justify-content: flex-end;
      align-items: center;
      gap: var(--space-4);
      margin-left: 0;
      text-align: left;
    }

    .airline-details {
      align-items: flex-start;
    }

    .desktop-only {
      display: none;
    }

    .model-bullet-mobile,
    .model-inline {
      display: inline;
    }
  }
</style>

