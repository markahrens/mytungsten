---
const {
  registration,
  model,
  flight,
  seen_date,
  owner,
  origin,
  destination,
  airline,
  operator,
  operated_by,
  origin_code_iata,
  origin_name,
  origin_city,
  destination_code_iata,
  destination_name,
  destination_city,
} = Astro.props;
---

<div class="adsb-row-container">
  <div class="adsb-row card">
    <!-- Aircraft details (Registration and Type) -->
    <div class="aircraft-col">
      <span class="registration-code">{registration || "Unknown Reg"}</span>
      <span class="type-code">{model || "Unknown Model"}</span>
    </div>
    
    <!-- Route details (Origin -> Destination, and Owner) -->
    <div class="route-col">
      <div class="route-airports">
        {origin && destination ? (
          <>
            <div class="airport-group">
              <span class="code">{origin_code_iata || origin}</span>
              {origin_name && <span class="airport-name">{origin_name}</span>}

            </div>
            <span class="arrow">→</span>
            <div class="airport-group">
              <span class="code">{destination_code_iata || destination}</span>
              {destination_name && <span class="airport-name">{destination_name}</span>}

            </div>
          </>
        ) : (
          <span class="no-route">No Known Route</span>
        )}
      </div>
      <div class="owner">
        {owner ? (
          <>
            {owner}
            {operated_by && owner.toLowerCase().indexOf(operated_by.toLowerCase()) === -1 && operated_by.toLowerCase().indexOf(owner.toLowerCase()) === -1 && (
              <span class="operator"> • Operated by {operated_by}</span>
            )}
          </>
        ) : (
          operated_by || "Private Owner"
        )}
      </div>
    </div>

    <!-- Flight / callsign info -->
    <div class="details-col">
      <div class="flight-number">{flight || "N/A"}</div>
    </div>
  </div>
</div>

<style>
  .adsb-row-container {
    margin-bottom: 12px;
  }

  .adsb-row {
    display: grid;
    grid-template-columns: 200px 1fr auto;
    align-items: center;
    padding: 16px 24px;
    gap: 24px;
    transition: all 0.2s ease;
  }

  .aircraft-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-right: 1px solid var(--color-border);
    padding-right: 24px;
    
    .registration-code {
      font-family: var(--font-hanken-grotesk);
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--color-text);
    }
    
    .type-code {
      font-size: 0.85rem;
      font-weight: 400;
      color: var(--color-metallic);
    }
  }

  .route-col {
    .route-airports {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 6px;

      .airport-group {
        display: flex;
        flex-direction: column;
        gap: 1px;

        .code {
          font-family: var(--font-hanken-grotesk);
          font-size: 1.4rem;
          font-weight: 600;
          color: var(--color-text);
          line-height: 1.1;
        }

        .airport-name {
          font-size: 0.8rem;
          font-weight: 500;
          color: var(--color-metallic);
        }


      }

      .no-route {
        font-family: var(--font-hanken-grotesk);
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--color-metallic);
      }

      .arrow {
        color: var(--color-metallic);
        font-weight: 400;
        font-size: 1.2rem;
        align-self: flex-start;
        margin-top: 0.25rem;
        flex-shrink: 0;
      }
    }
    
    .owner {
      font-size: 0.9rem;
      color: var(--color-metallic);
      font-weight: 500;
    }
  }

  .details-col {
    text-align: right;
    
    .flight-number {
      font-family: var(--font-hanken-grotesk);
      font-weight: 600;
      font-size: 1.4rem;
      color: var(--color-text);
    }
  }

  @media (max-width: 600px) {
    .adsb-row {
      grid-template-columns: 110px 1fr;
      padding: 12px 16px;
      gap: 16px;
    }
    .aircraft-col {
      padding-right: 16px;
      .registration-code { font-size: 1.05rem; }
      .type-code { font-size: 0.75rem; }
    }
    .details-col {
      display: none;
    }
  }
</style>
