---
const { href, number, date, dept_airport, arrival_airport, airline, distance } = Astro.props;
const newDate = new Date(date);
newDate.setUTCHours(12, 0, 0, 0);

import { getAirlineInfo } from "../lib/db";

const monthDay = newDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

let airline_info = null;
if (airline) {
  airline_info = getAirlineInfo(airline);
}
---

<a href={href} class="flight-row-item">
  <div class="date-col">{monthDay}</div>

  <div class="route-col">
    <span class="airport-code">{dept_airport}</span>
    <span class="route-arrow">→</span>
    <span class="airport-code">{arrival_airport}</span>
  </div>

  <div class="airline-col">{airline_info?.name || airline || 'United'}</div>

  <div class="number-col">{number}</div>

  <div class="distance-col">{distance ? Math.round(distance).toLocaleString() + ' mi' : ''}</div>

  <div class="arrow-col">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="5" y1="12" x2="19" y2="12"></line>
      <polyline points="12 5 19 12 12 19"></polyline>
    </svg>
  </div>
</a>

<style>
  .flight-row-item {
    display: grid;
    grid-template-columns: 90px 200px 140px 120px 1fr 40px;
    align-items: center;
    padding: var(--space-4) var(--space-6);
    background: var(--color-surface);
    text-decoration: none;
    color: inherit;
    transition: background-color var(--transition-standard);

    &:hover {
      background-color: var(--color-surface-alt);

      .arrow-col {
        transform: translateX(3px);
      }
    }

    @media (max-width: 800px) {
      grid-template-columns: 70px 1fr 40px;
      gap: var(--space-3);
      padding: var(--space-3) var(--space-4);
    }
  }

  .date-col {
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  .route-col {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .airport-code {
    font-size: 1.25rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-primary-dark);
  }

  .route-arrow {
    color: var(--color-text-muted);
    font-size: 1rem;
  }

  .airline-col, .number-col, .distance-col {
    font-size: 0.9375rem;
    color: var(--color-text-muted);

    @media (max-width: 800px) {
      display: none;
    }
  }

  .distance-col {
    text-align: right;
  }

  .arrow-col {
    display: flex;
    justify-content: flex-end;
    color: var(--color-primary-dark);
    transition: transform var(--transition-standard);
  }
</style>

