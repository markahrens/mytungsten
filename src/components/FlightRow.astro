---
const { href, number, date, dept_airport, arrival_airport, airline, distance} = Astro.props;
const newDate = new Date(date);
// Adjust for UTC/Local mismatch if necessary, but keep it simple
newDate.setUTCHours(12, 0, 0, 0);

import { getAirlineInfo } from "../lib/db";

const dateOptions: object = {
	month: "short",
	day: "numeric",
};

let airline_info = null;
if (airline) {
  airline_info = getAirlineInfo(airline);
}
---

<div class="flight-row-container">
  <a href={href} class="flight-row card card--interactive">
    <div class="date-col">
      <span class="month">{newDate.toLocaleDateString('en-US', { month: 'short' })}</span>
      <span class="day">{newDate.getUTCDate()}</span>
    </div>
    
    <div class="route-col">
      <div class="codes">
        <span class="code">{dept_airport}</span>
        <span class="arrow">→</span>
        <span class="code">{arrival_airport}</span>
      </div>
      <div class="airline">{airline_info?.name || airline}</div>
    </div>

    <div class="details-col">
      <div class="number">{number}</div>
      <div class="distance">{distance ? Math.round(distance) + ' mi' : ''}</div>
    </div>
  </a>
</div>

<style>
  .flight-row-container {
    margin-bottom: var(--space-3);
  }

  .flight-row {
    display: grid;
    grid-template-columns: minmax(90px, auto) 1fr auto;
    align-items: center;
    padding: var(--space-4) var(--space-6);
    gap: var(--space-6);
    text-decoration: none;
    color: inherit;
    &:before {
      display: none;
    }
  }

  .date-col {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
    border-right: 1px solid var(--color-border);
    padding-right: var(--space-6);
    
    .month, .day {
      font-family: var(--font-hanken-grotesk);
      font-size: 1.4rem;
      font-weight: 600;
      color: var(--color-text);
    }
  }

  .route-col {
    .codes {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-bottom: var(--space-1);
      
      .code {
        font-family: var(--font-hanken-grotesk);
        font-size: 1.4rem;
        font-weight: 600;
        color: var(--color-text);
      }
      
      .arrow {
        color: var(--color-metallic);
        font-weight: 400;
        font-size: 1.2rem;
      }
    }
    
    .airline {
      font-size: 0.9rem;
      color: var(--color-metallic);
      font-weight: 500;
    }
  }

  .details-col {
    text-align: right;
    
    .number {
      font-family: var(--font-hanken-grotesk);
      font-weight: 600;
      font-size: 1.1rem;
      color: var(--color-text);
      margin-bottom: 2px;
    }
    
    .distance {
      font-size: 0.8rem;
      color: var(--color-metallic);
      font-weight: 600;
    }
  }

  @media (max-width: 600px) {
    .flight-row {
      grid-template-columns: minmax(70px, auto) 1fr;
      padding: var(--space-3) var(--space-4);
      gap: var(--space-4);
    }
    .date-col {
      padding-right: var(--space-4);
      .day { font-size: 1.2rem; }
    }
    .details-col {
      display: none;
    }
  }
</style>
